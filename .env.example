# ---- Backend ----
OPENAI_API_KEY=sk-REPLACE_ME
AI_MODEL=gpt-4o
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/contractops
DEMO_TOKEN=demo-secret-token
APP_ENV=local
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM_EMAIL=contracts@example.com
SMTP_FROM_NAME=ContractOps AI
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
PUBLIC_APP_URL=http://localhost:3000
PORTAL_TOKEN_SECRET=replace-with-a-long-random-secret

# ---- Frontend (copy into frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_TOKEN=demo-secret-token
