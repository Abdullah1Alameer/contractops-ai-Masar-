          },
          "type": {
            "type": "string",
            "title": "Type"
          },
          "parent_main_contract_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Main Contract Id"
          }
        },
        "type": "object",
        "required": [
          "file",
          "type"
        ],
        "title": "Body_upload_contract_api_contracts_post"
      },
      "EventIn": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "event_date": {
            "type": "string",
            "format": "date",
            "title": "Event Date"
          }
        },
        "type": "object",
        "required": [
          "type",
          "event_date"
        ],
        "title": "EventIn"
      },
      "FlowdownIn": {
        "properties": {
          "main_contract_id": {
            "type": "string",
            "format": "uuid",
            "title": "Main Contract Id"
          },
          "subcontract_id": {
            "type": "string",
            "format": "uuid",
            "title": "Subcontract Id"
          }
        },
        "type": "object",
        "required": [
          "main_contract_id",
          "subcontract_id"
        ],
        "title": "FlowdownIn"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MilestonePatch": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "MilestonePatch"
      },
      "ObligationPatch": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "done",
              "overdue"
            ],
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "ObligationPatch"
      },
      "TodayIn": {
        "properties": {
          "today": {
            "type": "string",
            "format": "date",
            "title": "Today"
          }
        },
        "type": "object",
        "required": [
          "today"
        ],
        "title": "TodayIn"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
